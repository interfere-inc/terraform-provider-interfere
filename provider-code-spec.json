{
	"provider": {
		"name": "interfere"
	},
	"resources": [
		{
			"name": "private_key",
			"schema": {
				"attributes": [
					{
						"name": "idempotency_key",
						"string": {
							"computed_optional_required": "required"
						}
					},
					{
						"name": "name",
						"string": {
							"computed_optional_required": "required",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.LengthBetween(1, 64)"
									}
								}
							]
						}
					},
					{
						"name": "scopes",
						"list": {
							"computed_optional_required": "required",
							"element_type": {
								"string": {}
							},
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/listvalidator"
											}
										],
										"schema_definition": "listvalidator.SizeAtLeast(1)"
									}
								}
							]
						}
					},
					{
						"name": "seconds_until_expiration",
						"int64": {
							"computed_optional_required": "required",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/int64validator"
											}
										],
										"schema_definition": "int64validator.Between(-9007199254740991, 9007199254740991)"
									}
								}
							]
						}
					},
					{
						"name": "surface_slug",
						"string": {
							"computed_optional_required": "computed_optional",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "regexp"
											},
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^[a-z0-9]+(?:-[a-z0-9]+)*$\"), \"\")"
									}
								}
							]
						}
					},
					{
						"name": "expires_at",
						"int64": {
							"computed_optional_required": "computed"
						}
					},
					{
						"name": "id",
						"string": {
							"computed_optional_required": "computed"
						}
					},
					{
						"name": "version",
						"string": {
							"computed_optional_required": "computed"
						}
					},
					{
						"name": "workspace_slug",
						"string": {
							"computed_optional_required": "computed_optional",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "regexp"
											},
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^[a-z0-9]+(?:-[a-z0-9]+)*$\"), \"\")"
									}
								}
							]
						}
					}
				]
			}
		},
		{
			"name": "surface",
			"schema": {
				"attributes": [
					{
						"name": "idempotency_key",
						"string": {
							"computed_optional_required": "required"
						}
					},
					{
						"name": "name",
						"string": {
							"computed_optional_required": "required",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.LengthBetween(1, 255)"
									}
								}
							]
						}
					},
					{
						"name": "type",
						"string": {
							"computed_optional_required": "required",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.OneOf(\n\"elysia\",\n\"nest\",\n\"nextjs\",\n\"python\",\n\"react\",\n)"
									}
								}
							]
						}
					},
					{
						"name": "id",
						"string": {
							"computed_optional_required": "computed"
						}
					},
					{
						"name": "slug",
						"string": {
							"computed_optional_required": "computed"
						}
					},
					{
						"name": "workspace_slug",
						"string": {
							"computed_optional_required": "computed_optional",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "regexp"
											},
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^[a-z0-9]+(?:-[a-z0-9]+)*$\"), \"\")"
									}
								}
							]
						}
					}
				]
			}
		},
		{
			"name": "workspace",
			"schema": {
				"attributes": [
					{
						"name": "data_residency_location",
						"string": {
							"computed_optional_required": "computed"
						}
					},
					{
						"name": "id",
						"string": {
							"computed_optional_required": "computed"
						}
					},
					{
						"name": "name",
						"string": {
							"computed_optional_required": "computed"
						}
					},
					{
						"name": "workspace_slug",
						"string": {
							"computed_optional_required": "computed_optional",
							"validators": [
								{
									"custom": {
										"imports": [
											{
												"path": "regexp"
											},
											{
												"path": "github.com/hashicorp/terraform-plugin-framework-validators/stringvalidator"
											}
										],
										"schema_definition": "stringvalidator.RegexMatches(regexp.MustCompile(\"^[a-z0-9]+(?:-[a-z0-9]+)*$\"), \"\")"
									}
								}
							]
						}
					}
				]
			}
		}
	],
	"version": "0.1"
}